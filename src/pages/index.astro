---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import WeatherTeaser from '../components/WeatherTeaser.astro';
import { site, entity, foods, routes } from '../data/site.js';
import { seasons } from '../data/climate.js';
import { visitorServices } from '../data/visitor.js';
import { cityIntro, timeline } from '../data/history.js';

const homeFoods = foods.slice(0, 6);
const timeRoutes = routes.filter((r) => ['one-hour', 'two-hours', 'old-town-walk'].includes(r.slug));

const rating = entity.rating;

// 首頁常見問題（畫面看會著，同步供 FAQPage schema 使用）
const homeFaqs = [
  {
    q: `${entity.fullName}佇佗位？`,
    a: `Where is ${entity.fullName} located? — ${entity.fullName}（${entity.fullNameEn}）佇${entity.country}${entity.city}${entity.district}${entity.streetAddress}，Plus Code：${entity.plusCode}。`,
  },
  {
    q: `${entity.shortName}愛錢無？`,
    a: `Is ${entity.shortName} free to visit? — 免錢。廟埕佮街仔路是公共空間，全年會使自由來行踏；只有各店家的小食愛家己開錢。`,
  },
  {
    q: '暗時才有開？日時來有通食無？',
    a: '毋是干焦暗時。真濟廟埕老店對中晝就開始賣，日時來嘛食會著；暗時較有夜市氣氛、人嘛較濟。逐間時間無仝，出發進前請看店家公告。',
  },
  {
    q: '對新竹火車站按怎去？',
    a: `對台鐵新竹站行路約 10～15 分：沿中正路過東門圓環（東門城），越入中山路就到 ${entity.fullName}。詳細看交通停車頁。`,
  },
  {
    q: '附近有啥物景點通順紲去？',
    a: `順紲會使去${entity.landmarks[0]}、${entity.landmarks[1]}、${entity.landmarks[2]}佮${entity.landmarks[3]}，攏佇行路範圍；欲有系統，照舊城半晡路線行上四序。`,
  },
  {
    q: `${entity.fullName}的 Google 評分偌濟？`,
    a: `根據 ${rating.source}（${rating.sourceEn}）公開資訊，${entity.fullName} 評分 ${rating.value} 分，累積 ${rating.count.toLocaleString('en-US')} 則評論（${rating.checked}查核）。數字會綴評論變動，請以來源頁面為準。`,
  },
  {
    q: '愛留偌濟時間？',
    a: '干焦欲食，1 點鐘就夠；欲順紲拜拜、散步，抓 2～3 點鐘較四序。欲連舊城景點做一睏，會使安排半日。',
  },
  {
    q: '開車來，車停佗位？',
    a: '莫共車直接駛入廟口細巷。先揀車站抑東門城附近的收費停車場，行路 5～10 分入夜市較省事。放假時人濟車位歹揣，早寡來較好。',
  },
];

// 1. 結構化資料：TouristAttraction 實體綁定（@id + image + geo + hasMap + sameAs）
const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${site.url}/#attraction`,
  name: entity.fullName,
  alternateName: [entity.fullNameEn, entity.shortNameEn, ...entity.aliases],
  description: `Comprehensive visitor guide to ${entity.fullName} (${entity.fullNameEn}) in ${entity.cityEn}, ${entity.countryEn}.`,
  url: `${site.url}/`,
  image: [
    `${site.url}/images/market-night.jpg`,
    `${site.url}/images/temple-night.jpg`,
    `${site.url}/images/temple-facade.jpg`,
    `${site.url}/images/food-gongwan.jpg`,
    `${site.url}/images/east-gate.jpg`,
  ],
  isAccessibleForFree: true,
  touristType: '美食旅遊、夜市、古蹟參觀',
  address: {
    '@type': 'PostalAddress',
    streetAddress: entity.streetAddress,
    addressLocality: `${entity.city}${entity.district}`,
    addressRegion: entity.stateProvince,
    postalCode: entity.postalCode,
    addressCountry: entity.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: entity.latitude,
    longitude: entity.longitude,
  },
  hasMap: entity.mapsShareUrl,
  telephone: entity.phone,
  publicAccess: true,
  sameAs: [entity.mapsShareUrl, entity.tourismUrl, entity.templeOfficialUrl, entity.cityGovUrl],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: rating.value,
    reviewCount: rating.count,
    bestRating: rating.best,
    worstRating: rating.worst,
  },
  includesAttraction: entity.landmarks.map((name) => ({ '@type': 'TouristAttraction', name })),
  isPartOf: { '@id': `${site.url}/#website` },
};

// 2. FAQPage
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const jsonld = [attractionJsonLd, faqJsonLd];
---
<Layout
  title="新竹城隍廟夜市攻略｜必吃美食、營業時間、交通停車"
  description="新竹城隍廟夜市完整攻略：廟口必吃美食、夜市地圖、一般營業時間、交通與停車、參拜順序與舊城散步路線，適合第一次到訪的旅客。"
  jsonld={jsonld}>
  <!-- 1. 首屏 -->
  <section class="hero">
    <img
      class="hero-bg"
      src="/images/market-night.jpg"
      alt={`${entity.fullName} - Main view in ${entity.cityEn}, ${entity.countryEn}`}
      loading="eager"
      fetchpriority="high"
      decoding="async" />
    <div class="hero-scrim"></div>
    <div class="wrap hero-inner">
      <span class="kicker kicker-light">新竹廟口・夜市指南</span>
      <h1>新竹城隍廟夜市指南</h1>
      <p class="hero-official">
        官方名稱：{entity.fullName}（{entity.fullNameEn}）・{entity.city}{entity.district}
      </p>
      <p class="hero-lede">
        第一次來吃什麼、怎麼逛、車停哪裡，一次整理給你。<br>
        <span class="tailo">Sin-tik Sîng-hông-biō — chia̍h-mi̍h、án-ná tshit-thô、thîng-tshia</span>
      </p>
      <p class="hero-rating">
        <span class="rating-stars" aria-hidden="true">★★★★☆</span>
        <strong class="rating-score">{rating.value}／{rating.best}</strong>
        <span class="rating-count">{rating.count.toLocaleString('en-US')} 則評論</span>
        <span class="rating-src">
          資料來源：<a href={rating.sourceUrl} target="_blank" rel="noopener noreferrer">{rating.source}</a>
          （{rating.checked}查核）
        </span>
      </p>
      <div class="hero-facts">
        <span class="pill pill--gold">門票免費</span>
        <span class="pill">建議停留 1.5～3 點鐘</span>
        <span class="pill">中山路 75 號</span>
        <span class="pill">火車站行路會到</span>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/first-visit/">第一次來怎麼逛 →</a>
        <a class="btn btn-ghost btn-ghost-light" href="/map/">看夜市地圖</a>
      </div>
      <p class="hero-sub">
        或是先看　<a href="/food/">必吃美食</a>　·　<a href="/transport/">交通與停車</a>
      </p>
    </div>
  </section>

  <!-- 2. 城隍廟夜市是啥物 -->
  <section class="section">
    <div class="wrap">
      <span class="kicker">先搞清楚</span>
      <h2>城隍廟夜市到底是啥物？</h2>
      <p class="lede">
        新竹城隍廟夜市毋是暗時才開始擺的大型夜市，是以<strong>新竹都城隍廟</strong>做中心，
        由廟埕固定攤位、周邊老店、中央市場佮附近街仔路鬥做伙的<strong>廟口美食區</strong>。
        有一寡店對日時抑晏起就開始賣，所以毋一定愛等到暗時才來。
      </p>
      <div class="grid grid-4" style="margin-top:26px">
        <div class="card"><div class="card__body">
          <div class="mini-ico">🍜</div><h3 class="card__title">廟內底就有攤</h3>
          <p>廟埕本身就是小吃區，毋免揣真久。</p>
        </div></div>
        <div class="card"><div class="card__body">
          <div class="mini-ico">☀️</div><h3 class="card__title">日時嘛食會著</h3>
          <p>足濟店對中晝就開，白天來嘛袂空手。</p>
        </div></div>
        <div class="card"><div class="card__body">
          <div class="mini-ico">🕗</div><h3 class="card__title">逐間時間無仝</h3>
          <p>各店營業佮公休攏無仝，出發進前愛先看。</p>
        </div></div>
        <div class="card"><div class="card__body">
          <div class="mini-ico">🏯</div><h3 class="card__title">會當鬥舊城</h3>
          <p>通佮東門城、北門街做一站舊城𨑨迌。</p>
        </div></div>
      </div>
    </div>
  </section>

  <!-- 2.5 SEO 實體綁定：單景點 Entity Section（About / Location / Landmarks / History） -->
  <section class="section band-entity" id="about-attraction">
    <div class="wrap">
      <nav class="entity-crumbs" aria-label="地理歸屬">
        <ol>
          <li>{entity.country}</li>
          <li>{entity.city}</li>
          <li>{entity.district}</li>
          <li aria-current="page">{entity.fullName}</li>
        </ol>
      </nav>

      <span class="kicker">Entity / 實體</span>
      <h2>About {entity.fullName}（{entity.fullNameEn}）</h2>
      <p class="lede">
        Welcome to <strong>{entity.fullName}</strong>, widely recognized as the central
        <strong>{entity.shortNameEn}</strong>（{entity.shortName}）. Located in the heart of
        <strong>{entity.cityEn}</strong>, {entity.stateProvinceEn}, {entity.countryEn},
        this destination serves as a primary hub for travelers visiting the region.
      </p>
      <p class="lede">
        換咱的話講：<strong>{entity.fullName}</strong>就是逐家上熟悉的<strong>{entity.shortName}</strong>，
        位佇{entity.country}{entity.city}{entity.district}，是旅客來到新竹上主要的美食佮信仰中心。
      </p>

      <div class="grid grid-3" style="margin-top:24px">
        <div class="card"><div class="card__body">
          <h3 class="card__title">地址佮座標</h3>
          <p>{entity.country}{entity.city}{entity.district}{entity.streetAddress}</p>
          <p class="tailo">Plus Code：{entity.plusCode}</p>
          <p class="tailo">經緯度：{entity.latitude}, {entity.longitude}</p>
        </div></div>
        <div class="card"><div class="card__body">
          <h3 class="card__title">聯絡佮類別</h3>
          <p>類別：{entity.category}</p>
          <p>電話：<a href={`tel:${entity.phoneHref}`}>{entity.phone}</a></p>
          <p>門票：免費</p>
        </div></div>
        <div class="card"><div class="card__body">
          <h3 class="card__title">Google 評分</h3>
          <p class="entity-rating">
            <span class="rating-stars" aria-hidden="true">★★★★☆</span>
            <strong>{rating.value}／{rating.best}</strong>
          </p>
          <p>{rating.count.toLocaleString('en-US')} 則評論</p>
          <p class="tailo">
            來源：<a href={rating.sourceUrl} target="_blank" rel="noopener noreferrer">{rating.source}</a>（{rating.checked}查核）
          </p>
        </div></div>
      </div>

      <h2 class="entity-h2">Location &amp; How to Visit {entity.shortNameEn} in {entity.cityEn}</h2>
      <p class="lede">對新竹火車站行路約 10～15 分就會到；開車請先揀外圍停車場。實際行路請配下面的地圖導航。</p>
      <div class="gmap-frame">
        <iframe
          src={site.mapsEmbed}
          title={`${entity.fullName}（${entity.fullNameEn}）Google 地圖位置`}
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <p class="entity-links">
        <a class="btn btn-ghost" href="/map/">看夜市導覽地圖 →</a>
        <a class="btn btn-ghost" href="/transport/">看交通佮停車 →</a>
      </p>

      <h2 class="entity-h2">Landmarks &amp; Attractions Around {entity.shortNameEn}</h2>
      <p class="lede">
        When visiting <strong>{entity.fullName}</strong>, visitors can easily explore surrounding
        historical landmarks and points of interest, including
        <strong>{entity.landmarks[0]}</strong> and <strong>{entity.landmarks[1]}</strong>.
      </p>
      <div class="tags" style="margin-top:12px">
        {entity.landmarks.map((l) => <span class="pill">{l}</span>)}
      </div>
      <p><a class="more" href="/nearby/">看全部附近景點 →</a></p>

      <h2 class="entity-h2">History &amp; Significance of {entity.fullName}</h2>
      <p class="lede">
        新竹都城隍廟創建佇 1748 年，是市定古蹟，嘛是廟口夜市的中心。城隍爺是掌管一个地方陰陽、
        賞善罰惡的神明；新竹城隍位階特別懸，號做「都城隍」。
      </p>
      <p class="entity-source">
        For official updates and regional tourism information, visit
        <a href={entity.tourismUrl} target="_blank" rel="noopener noreferrer">Taiwan / {entity.cityEn} Official Tourism Portal ↗</a>
        抑是<a href={entity.templeOfficialUrl} target="_blank" rel="noopener noreferrer">新竹都城隍廟官方網站 ↗</a>。
      </p>
    </div>
  </section>

  <!-- 3. 第一擺必食 -->
  <section class="section band-cream">
    <div class="wrap">
      <div class="row-head">
        <div>
          <span class="kicker">第一次必吃</span>
          <h2>第一次來吃什麼？</h2>
          <p class="lede">先挑食物種類，免得第一次就為了選店選到眼花。</p>
        </div>
        <a class="btn btn-ghost hide-mobile" href="/food/">看全部美食 →</a>
      </div>
      <div class="grid grid-3" style="margin-top:26px">
        {homeFoods.map((f) => (
          <a class="card food-card" href={`/food/#${f.slug}`}>
            <img class="card__img" src={`/images/${f.img}`} alt={f.name} loading="lazy" />
            <div class="card__body">
              <span class="pill pill--red food-tag">{f.tag}</span>
              <h3 class="card__title">{f.name}</h3>
              <p class="tailo food-tl">{f.tailo}</p>
              <p class="food-desc">{f.desc}</p>
              <div class="food-meta">
                <span>{f.price}</span><span class="dot">·</span><span>{f.share}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:22px">
        <a class="btn btn-primary" href="/food/">看全部夜市美食 →</a>
      </div>
    </div>
  </section>

  <!-- 4. 按時間揀路線 -->
  <section class="section">
    <div class="wrap">
      <span class="kicker">看你有偌濟時間</span>
      <h2>按停留時間揀路線</h2>
      <div class="grid grid-3" style="margin-top:26px">
        {timeRoutes.map((r) => (
          <a class="card route-card" href={`/routes/#${r.slug}`}>
            <div class="card__body">
              <div class="route-time">{r.duration}</div>
              <h3 class="card__title">{r.name}</h3>
              <p>{r.summary}</p>
              <ol class="mini-steps">
                {r.steps.slice(0, 3).map((s) => <li>{s}</li>)}
              </ol>
              <div class="card__meta">預算 {r.budget}</div>
            </div>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:22px">
        <a class="btn btn-ghost" href="/routes/">看全部遊逛路線 →</a>
      </div>
    </div>
  </section>

  <!-- 5. 夜市地圖預覽 -->
  <section class="section band-red">
    <div class="wrap map-preview">
      <div>
        <span class="kicker kicker-light">全站上愛的功能</span>
        <h2 class="light">夜市導覽地圖</h2>
        <p class="light-lede">
          原創 SVG 靜態地圖，共城隍廟、廟埕小吃區、中山路、東門街、
          中央市場佮東門城方向攏畫予你看。點標記就會當看店家佮路線。
        </p>
        <div class="hero-cta">
          <a class="btn btn-gold" href="/map/">看完整夜市地圖 →</a>
          <a class="btn btn-ghost btn-ghost-light" href={site.mapsUrl} target="_blank" rel="noopener">開啟外部導航 ↗</a>
        </div>
      </div>
      <Photo src="temple-arch.jpg" alt="新竹都城隍廟牌樓佮廟埕" ratio="4/3" />
    </div>
  </section>

  <!-- 6. 兩人按怎點 -->
  <section class="section">
    <div class="wrap two-col">
      <Photo src="food-stands.jpg" alt="城隍廟周邊的小吃攤位" ratio="5/4" />
      <div>
        <span class="kicker">兩人來最實用</span>
        <h2>兩人怎麼點？</h2>
        <p class="lede">兩人來，每樣分做兩份，可以吃到比較多款。</p>
        <ul class="steps" style="margin-top:14px">
          <li>一碗米粉摃丸湯先開場，鹹甜芳暖胃。</li>
          <li>一份新竹肉圓，切做兩爿分。</li>
          <li>一份蚵仔煎鬥一碗羹湯。</li>
          <li>甜點揀燒麻糬抑水蒸糕收尾。</li>
        </ul>
        <a class="btn btn-ghost" href="/routes/#two-person-food-walk" style="margin-top:6px">看兩人分食路線 →</a>
      </div>
    </div>
  </section>

  <!-- 7. 交通佮停車 -->
  <section class="section band-cream">
    <div class="wrap">
      <span class="kicker">怎麼去・車停哪裡</span>
      <h2>交通與停車</h2>
      <div class="grid grid-3" style="margin-top:24px">
        <div class="card"><div class="card__body">
          <div class="mini-ico">🚉</div><h3 class="card__title">從新竹火車站</h3>
          <p>適合步行，沿中正路、東門圓環、中山路就進入城隍廟周邊。</p>
          <a href="/transport/#from-station" class="more">看步行方式 →</a>
        </div></div>
        <div class="card"><div class="card__body">
          <div class="mini-ico">🚄</div><h3 class="card__title">從高鐵新竹站</h3>
          <p>要先轉台鐵、公車、接駁或計程車才進市區。</p>
          <a href="/transport/#from-hsr" class="more">看轉乘方式 →</a>
        </div></div>
        <div class="card"><div class="card__body">
          <div class="mini-ico">🅿️</div><h3 class="card__title">自行開車</h3>
          <p>別把車直接開進廟口窄巷，先停外圍停車場再步行較省事。</p>
          <a href="/transport/#parking" class="more">看停車建議 →</a>
        </div></div>
      </div>
      <div class="note" style="margin-top:20px">
        <strong>提醒：</strong>公車路線佮接駁服務會使調整，本站以「路線原則＋外部即時導航」呈現，無共班次寫死。
      </div>
    </div>
  </section>

  <!-- 7.5 天氣佮四季策略 -->
  <section class="section" id="weather">
    <div class="wrap">
      <div class="row-head">
        <div>
          <span class="kicker">出發進前先看</span>
          <h2>天氣佮四季策略</h2>
          <p class="lede">
            新竹的風誠有名：秋冬「九降風」透起來，風冷比溫度較有感；5～6 月梅雨、7～9 月颱風季。
            先看即時天氣，才照季節安排。
          </p>
        </div>
        <a class="btn btn-ghost hide-mobile" href="/weather/">看逐日預報佮四季策略 →</a>
      </div>

      <div class="weather-home">
        <WeatherTeaser />
        <div class="season-mini">
          <p class="season-mini__cap">四季按呢安排</p>
          {seasons.map((s) => (
            <a class={`season-mini__item is-${s.tone}`} href="/weather/#seasons">
              <span class="season-mini__badge">{s.tailo}</span>
              <span class="season-mini__body">
                <strong>{s.name}</strong>
                <em>{s.months}・{s.climate.comfort}</em>
              </span>
            </a>
          ))}
          <a class="season-mini__all" href="/weather/#seasons">看氣候・環境・生態的四季策略表 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7.6 訪客服務佮周邊設施 -->
