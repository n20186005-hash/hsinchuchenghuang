---
import Layout from '../../layouts/Layout.astro';
import { site, entity } from '../../data/site.js';
import { visitorServices, responsibility } from '../../data/visitor.js';

const serviceFaqs = [
  {
    q: `${entity.shortName}揣會著便所無？`,
    a: '有。廟宇內底有提供香客佮遊客使用的廁所，廟埕周邊的公有市場、公有停車場佮公共建築嘛有。'
      + '暗時有的市場廁所會鎖起來，欲轉進前先解決較穩當。',
  },
  {
    q: '開車來，車欲停佗位？',
    a: '廟口周邊路仔狹、路邊車位少，一般建議共車停佇外圍的收費停車場（車站抑東門城附近），'
      + '才行路 5～10 分入夜市。莫共車直接駛入廟口的細巷，假日閣較是。',
  },
  {
    q: '附近有便利商店佮超市無？',
    a: '主要道路沿線的連鎖便利商店密度誠懸，行路範圍內底通常揣會著；'
      + '連鎖超市佇市中心商圈內底，早起的話傳統市場的菜蔬魚肉上青。',
  },
  {
    q: '𤆬囡仔抑𤆬序大人來，敢有方便？',
    a: '廟埕一帶以平路為主，毋過老街仔的騎樓佮市場內底有懸低差。'
      + '哺乳室佮尿布台佇車站、百貨佮大型公共建築；輪椅動線建議行中山路、中正路的人行道，'
      + '中央市場內底改行外圍的騎樓。詳細安排看「𨑨迌路線」的低體力佮無障礙路線。',
  },
  {
    q: '外籍旅客換錢佮辦門號方便無？',
    a: '現金換匯主要佇銀行分行臨櫃，有營業日佮時間限制；ATM 是 24 點鐘。'
      + '預付卡愛帶護照去市區的電信門市辦理。夜市仔的固定攤位以現金為主，'
      + '建議先傳好零錢；行動支付看店家貼紙。',
  },
  {
    q: '這個頁面敢有推薦特定店家？',
    a: '無。本站是無營利的景點科普網站，這頁干焦講「有佗一款設施、通常佇佗位、愛注意啥物」，'
      + '無收受任何商家贊助，嘛無共任何一間店排順序抑是掛保證。',
  },
];

const situationIndex = [
  { id: 'rain', badge: '雨', name: '拄著落雨', need: '傘／雨幔補貨點、崁頂動線、室內歇睏點', link: '#shop' },
  { id: 'hot', badge: '熱', name: '熱天正午', need: '冷氣歇睏點、補水、公廁', link: '#water' },
  { id: 'kids', badge: '囡', name: '𤆬囡仔', need: '哺乳室、尿布台、囡仔椅、平路動線', link: '#baby' },
  { id: 'elder', badge: '長', name: '𤆬序大人', need: '座椅、便所、無障礙動線、復康巴士', link: '#access' },
  { id: 'car', badge: '車', name: '家己開車', need: '外圍停車、加油、充電', link: '#parking' },
  { id: 'night', badge: '暗', name: '暗時來', need: '照明、治安、領錢、大眾運輸', link: '#help' },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${entity.fullName}訪客服務佮周邊設施（類型）`,
    description: '照設施類型整理，無推薦任何特定商家。',
    itemListElement: visitorServices.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.name,
        description: s.summary,
        areaServed: { '@type': 'Place', name: `${entity.city}${entity.district}` },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: serviceFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="訪客服務佮周邊設施｜便所、停車、餐飲、住宿、加油充電"
  description={`${entity.fullName}的訪客服務佮周邊設施總覽：公共廁所、汽車機車停車、餐飲類型、各級住宿、便利商店佮超市、加油佮充電、醫療藥局、提款換匯、置物寄物、飲水、無障礙、親子母嬰、通訊充電佮求助治安。照類型中立介紹，無推薦特定店家。`}
  jsonld={jsonld}
>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">頭頁</a> ／ 實用資訊</p>
      <span class="kicker">食食蹛蹛・攏佇遮解決</span>
      <h1>訪客服務佮周邊設施</h1>
      <p class="lede">
        來一个所在𨑨迌，真正予人煩惱的往往是「便所佇佗」、「車欲停佗」、「暗時有冷氣會當歇一下無」。
        這頁照<strong>設施類型</strong>共這區的機能一擺講清楚：包括便所、停車、餐飲、住宿、便利商店佮超市、
        加油佮充電、醫療藥局、金融換匯、郵寄寄物、飲水、無障礙、親子母嬰、通訊充電佮求助治安。
      </p>
      <p class="note" style="margin-top:18px">
        <strong>中立聲明：</strong>本站是無營利的景點科普網站，這頁干焦講「有佗一款設施」佮「愛注意啥物」，
        <strong>無推薦、無排名、無掛保證任何一間店</strong>，嘛無收受任何商家贊助。
        設施會徙位、會歇業、會變更營業時間，出發進前請以現場告示抑官方公告為準。
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="tags">
        {visitorServices.map((s) => (
          <a class="pill" href={`#${s.id}`}>{s.name}</a>
        ))}
        <a class="pill pill--gold" href="#responsibility">科普佮訪客責任</a>
        <a class="pill pill--gold" href="#services-faq">服務問答</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="wrap">
      <h2>按情境揣設施</h2>
      <p class="lede">若你無想欲逐項看，直接對你的情境揣起。</p>
      <div class="grid grid-3" style="margin-top:20px">
        {situationIndex.map((s) => (
          <a class="situ" href={s.link}>
            <span class="situ__badge">{s.badge}</span>
            <span class="situ__body">
              <strong>{s.name}</strong>
              <em>{s.need}</em>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-cream">
    <div class="wrap">
      <span class="kicker">逐項講清楚</span>
      <h2>十四款設施，一款一款來</h2>
      <p class="lede">
        每一項攏分三塊：這款設施是啥物、通常佇佗位、實際用的時陣愛注意啥物。
      </p>

      <div class="fac-list">
        {visitorServices.map((s, i) => (
          <article class="fac" id={s.id}>
            <div class={`fac__badge is-${s.tone}`}>
              <span>{s.badge}</span>
              <em>{String(i + 1).padStart(2, '0')}</em>
            </div>
            <div class="fac__body">
              <h3>{s.name}<span class="fac__tailo">{s.tailo}</span></h3>
              <p class="fac__summary">{s.summary}</p>

              <div class="fac__cols">
                <div>
                  <h4>通常佇佗位</h4>
                  <ul>
                    {s.where.map((w) => <li>{w}</li>)}
                  </ul>
                </div>
                <div>
                  <h4>實用提醒</h4>
                  <ul>
                    {s.tips.map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="responsibility">
    <div class="wrap">
      <span class="kicker">科普佮訪客責任</span>
      <h2>𨑨迌的時，加減共遮想看</h2>
      <p class="lede">
        這區毋是「打造出來的觀光區」，是一个有人蹛、有人買賣、有人拜拜的舊城中心。
        下面的內容是景點科普，嘛是逐家來會使做伙守的分際。
      </p>

      <div class="resp-list">
        {responsibility.map((r) => (
          <article class="resp" id={`resp-${r.id}`}>
            <div class="resp__head">
              <span class="resp__badge">{r.badge}</span>
              <div>
                <h3>{r.name}<span class="fac__tailo">{r.tailo}</span></h3>
                <p class="resp__lead">{r.lead}</p>
              </div>
            </div>
            <ul class="resp__items">
              {r.items.map((it) => <li>{it}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="note" style="margin-top:26px">
        <strong>延伸：</strong>
        想看廟宇的歷史佮建築，去<a href="/history/">竹塹舊城佮城隍廟的來歷</a>；
        想看參拜的順序佮禮儀，去<a href="/temple/">城隍廟參觀指南</a>；
        想看天氣佮四季的遊憩策略，去<a href="/weather/">天氣佮四季策略</a>。
      </div>
    </div>
  </section>

  <section class="section band-cream" id="services-faq">
    <div class="wrap">
      <span class="kicker">上捷問的</span>
      <h2>訪客服務問答</h2>
      <div class="faq-list">
        {serviceFaqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <div class="faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
      <p style="margin-top:22px">
        <a class="btn btn-primary" href="/transport/">看交通佮停車詳細版 →</a>
        <a class="btn btn-ghost" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer" style="margin-left:10px">開啟外部導航 ↗</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .band-cream { background: linear-gradient(180deg, var(--cream-2), var(--cream)); }

  .situ {
    display: flex;
    gap: 14px;
    align-items: center;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 18px;
    box-shadow: var(--shadow-sm);
    color: inherit;
  }
  .situ:hover { border-color: #e0cfae; transform: translateY(-2px); }
  .situ__badge {
    flex: none;
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border-radius: 12px;
    background: #fbeede;
    color: var(--red-dark);
    font-weight: 800;
  }
  .situ__body { display: grid; gap: 2px; }
  .situ__body strong { font-size: 1rem; }
  .situ__body em { font-style: normal; font-size: .84rem; color: var(--stone); }

  .fac-list { display: grid; gap: 18px; margin-top: 30px; }
  .fac {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 22px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 24px 26px;
    box-shadow: var(--shadow-sm);
  }
  .fac__badge {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 4px;
    border-radius: 16px;
    padding: 14px 6px;
    background: #fbeede;
    color: var(--red-dark);
  }
  .fac__badge.is-gold { background: #fdf4e2; color: #8a6314; }
  .fac__badge.is-green { background: #f1f6f2; color: #2f7a4f; }
  .fac__badge.is-stone { background: #f3f0eb; color: var(--ink-soft); }
  .fac__badge span { font-size: 1.3rem; font-weight: 800; line-height: 1; }
  .fac__badge em { font-style: normal; font-size: .72rem; letter-spacing: .08em; opacity: .7; }

  .fac__body h3 { margin: 0; font-size: 1.22rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .fac__tailo { font-size: .8rem; font-weight: 600; color: var(--stone); letter-spacing: .02em; }
  .fac__summary { margin: 10px 0 0; color: var(--ink-soft); }

  .fac__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 18px;
  }
  .fac__cols h4 {
    margin: 0 0 8px;
    font-size: .82rem;
    letter-spacing: .06em;
    color: var(--stone);
    font-weight: 800;
  }
  .fac__cols ul { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; }
  .fac__cols li { font-size: .92rem; color: var(--ink-soft); line-height: 1.65; }

  .resp-list { display: grid; gap: 18px; margin-top: 30px; }
  .resp {
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 6px solid var(--red);
    border-radius: var(--radius-lg);
    padding: 24px 26px;
    box-shadow: var(--shadow-sm);
  }
  .resp__head { display: flex; gap: 16px; align-items: flex-start; }
  .resp__badge {
    flex: none;
    width: 42px; height: 42px;
    display: grid; place-items: center;
    border-radius: 12px;
    background: var(--red);
    color: #fff;
    font-weight: 800;
  }
  .resp__head h3 { margin: 0; font-size: 1.18rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .resp__lead { margin: 6px 0 0; color: var(--ink-soft); font-size: .95rem; }
  .resp__items { margin: 16px 0 0; padding-left: 1.15em; display: grid; gap: 8px; }
  .resp__items li { font-size: .94rem; line-height: 1.7; color: var(--ink-soft); }

  .faq-list { margin-top: 24px; max-width: 860px; }
  .faq {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 12px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .faq summary {
    cursor: pointer; padding: 18px 22px; font-weight: 800; font-size: 1.03rem;
    list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 14px;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '＋'; color: var(--red); font-size: 1.3rem; flex: none; }
  .faq[open] summary::after { content: '－'; }
  .faq[open] summary { color: var(--red-dark); }
  .faq-a { padding: 0 22px 20px; }
  .faq-a p { margin: 0; color: var(--ink-soft); }

  @media (max-width: 760px) {
    .fac { grid-template-columns: 1fr; gap: 16px; padding: 20px; }
    .fac__badge { grid-auto-flow: column; justify-content: start; justify-items: start; gap: 10px; padding: 10px 14px; }
    .fac__badge span { font-size: 1.05rem; }
    .fac__cols { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
