---
import { site, footerNav } from '../data/site.js';
---
<footer class="site-footer">
  <div class="wrap foot-grid">
    <div>
      <div class="foot-brand">
        <span class="brand-mark" aria-hidden="true">城</span>
        <div>
          <strong>{site.name}</strong>
          <p class="tailo">{site.nameTailo}</p>
        </div>
      </div>
      <p class="foot-tag">{site.tagline}</p>
      <div class="foot-info">
        <h4>基本資料</h4>
        <p>地址：{site.address}</p>
        <p>門票：免費</p>
        <a class="btn btn-gold" href={site.mapsUrl} target="_blank" rel="noopener">開啟外部導航 ↗</a>
      </div>
    </div>
    {footerNav.map((g) => (
      <nav aria-label={`頁尾選單：${g.title}`}>
        <h4>{g.title}</h4>
        {g.links.map((i) => <a href={i.href}>{i.label}</a>)}
      </nav>
    ))}
  </div>

  <div class="wrap disclaimer">
    <p>
      <strong>本站是獨立旅遊資訊網站</strong>，毋是新竹都城隍廟、新竹市政府抑是店家的官方網站。
      營業時間、價數佮交通資訊會使調整，出發進前請以現場佮官方公告做準。
    </p>
    <p class="review">
      店家營業時間、價數、公休佮交通會使變動，請以最新公告為準。<br>
      相片來源：Wikimedia Commons，依 CC 授權使用，已標示作者佮授權條款。
    </p>
    <p class="copy">© 2026 HsinchuChengHuang.com｜{site.name}</p>
  </div>
</footer>

<style>
  .site-footer { background: #24201d; color: #cdc3b6; margin-top: 40px; }
  .foot-grid {
    display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 34px;
    padding: 52px 20px 30px;
  }
  .foot-brand { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
  .foot-brand .brand-mark {
    width: 44px; height: 44px; border-radius: 10px;
    background: linear-gradient(160deg, var(--red), var(--red-dark));
    color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 1.4rem;
    border: 2px solid var(--gold-soft);
  }
  .foot-brand strong { color: #fff; font-size: 1.1rem; }
  .foot-brand .tailo { margin: 0; font-size: .82rem; }
  .foot-tag { color: #a99f92; font-size: .95rem; margin-bottom: 8px; }
  .site-footer h4 { color: #fff; font-size: .92rem; letter-spacing: .1em; margin: 0 0 12px; }
  .site-footer nav a, .foot-info p, .foot-info a { display: block; color: #cdc3b6; padding: 4px 0; font-size: .93rem; }
  .site-footer nav a:hover { color: var(--gold-soft); }
  .foot-info { margin-top: 22px; }
  .foot-info .btn { display: inline-flex; margin-top: 12px; color: #fff; }
  .disclaimer { border-top: 1px solid #3a342e; padding: 22px 20px 40px; }
  .disclaimer p { font-size: .84rem; color: #9a9084; line-height: 1.7; }
  .disclaimer strong { color: #e6ddceff; }
  .disclaimer .review { color: #7f766b; }
  .disclaimer .copy { color: #6f665c; margin: 0; }
  @media (max-width: 900px) { .foot-grid { grid-template-columns: 1fr 1fr; gap: 26px; } }
  @media (max-width: 560px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
