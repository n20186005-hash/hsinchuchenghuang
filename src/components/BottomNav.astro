---
import { bottomNav } from '../data/site.js';
const path = Astro.url.pathname;
const icons = {
  home: '<path d="M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>',
  bowl: '<path d="M3 11h18a9 9 0 0 1-9 9 9 9 0 0 1-9-9Z"/><path d="M8 7c0-2 1-3 2-3M12 7c0-2 1-3 2-3"/>',
  map:  '<path d="m9 4 6 2 5-2v14l-5 2-6-2-5 2V6l5-2Zm0 0v14m6-12v14"/>',
  route:'<circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><path d="M8 18h7a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h1"/>',
};
---
<nav class="bottom-nav" aria-label="手機導覽">
  {bottomNav.map((i) => (
    <a href={i.href} class:list={["bn-link", { active: i.href === '/' ? path === '/' : path.startsWith(i.href) }]}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i.icon]}></svg>
      <span>{i.label}</span>
    </a>
  ))}
</nav>

<style>
  .bottom-nav { display: none; }
  @media (max-width: 720px) {
    .bottom-nav {
      display: grid; grid-template-columns: repeat(4, 1fr);
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      background: rgba(255,253,248,.96); backdrop-filter: blur(8px);
      border-top: 1px solid var(--line);
      box-shadow: 0 -4px 18px rgba(80,40,20,.08);
    }
    .bn-link {
      display: flex; flex-direction: column; align-items: center; gap: 3px;
      padding: 8px 0 9px; color: var(--stone); font-size: .72rem; font-weight: 700;
    }
    .bn-link svg { width: 23px; height: 23px; }
    .bn-link.active { color: var(--red); }
  }
</style>
